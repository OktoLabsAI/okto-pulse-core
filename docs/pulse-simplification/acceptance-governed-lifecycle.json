  "criteria": {
    "BASE:T02": {
      "status": "verified",
      "covered": "A reviewer who is creator/assignee/executor is refused under enforce before persisting validation or changing Card status; MCP returns reviewer_separation_required and explicit independent-review remediation. Off/warn/legacy policy modes preserve their declared behavior and recorded reviewer identity; an independent reviewer is allowed by the policy."
    },
    "BASE:T08": {
      "status": "verified",
      "covered": "Real Community SQL/session/CardService matrix normal|bug x in_progress|validation refuses direct Done when Spec requires task validation. An outer commit cannot change status, subject version, validations or conclusions."
    },
    "BASE:T09": {
      "status": "verified",
      "covered": "Test Cards refuse normal task-validation submissions with the scenario-status/move-to-Done contract and no fake review. Draft/ready scenarios prevent completion, pending scenarios are identified, and the scenario gate releases only after passing. The separate installed authenticated Test Card closeout is qualified in evidence-completion-authenticated.json."
    },
    "BASE:T10": {
      "status": "verified",
      "covered": "Authorized Spec reopen advances one edition, marks previous evaluations without rewriting their original scores/identity/content, requires a new review after content changes, and prevents same-edition rejection from being erased by a later approval. Failed reopen rolls back edition/history; content mutation outside allowed draft state has zero writes. Card rejection and validation history remain append-only and only the rework exit is public."
    },
    "BASE:T11": {
      "status": "verified",
      "covered": "A second real Community semantic SQL session changes Card content through CardService after the reviewer reads its version. Stale approval is refused with task_validation_subject_version_conflict; outer commit adds no assessment, rejection, activity or event and preserves the edited subject. Supplementary lifecycle fence/old-edition tests and concurrent Spec reviews preserve accepted records."
    },
    "BASE:T12": {
      "status": "verified",
      "covered": "Identical task-validation retries reuse the recorded result after rejected and Done states. A changed payload under the same idempotency key returns 409 task_validation_idempotency_conflict; rejection cause and history are not duplicated. Done replay isolates completion prerequisites; the separate authenticated canonical report replay is qualified by T40."
    }
  },
